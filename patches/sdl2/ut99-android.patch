+    }
+    BufferData bufferData = (BufferData)SDL_GL_GetProcAddress("glBufferData");
+    if (!bufferData) { fprintf(stderr, "UNSUPPORTED glBufferData\n"); fflush(stderr); abort(); }
+    fprintf(stderr, "UT GL buffer-storage fallback target=0x%x size=%lld flags=0x%x\n", target, (long long)size, flags);
